{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.18"
  },
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "agentbar",
      "type": "block",
      "size": {
        "px": 138
      },
      "window_drag": true,
      "content": {
        "mod": "agent-bar"
      }
    },
    {
      "id": "work-body",
      "type": "row",
      "padding": 8,
      "gap": 8,
      "children": [
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "gap": 8,
              "radius": 10,
              "background": "background",
              "lone": true,
              "border": {
                "width": 1,
                "color": "border"
              },
              "focus": {
                "width": 1,
                "color": "accent"
              },
              "header": {
                "content": {
                  "mod": "pane"
                },
                "height": 30,
                "position": "top",
                "reveal": "always"
              }
            }
          }
        },
        {
          "id": "panel",
          "type": "column",
          "hidden": true,
          "size": {
            "px": 368
          },
          "min": 280,
          "max": 900,
          "children": [
            {
              "id": "panel-body",
              "type": "stack",
              "active": "files",
              "children": [
                {
                  "id": "files",
                  "type": "block",
                  "content": {
                    "mod": "files"
                  }
                },
                {
                  "id": "changes",
                  "type": "block",
                  "content": {
                    "mod": "changes"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "newtask-cache",
      "type": "block",
      "size": {
        "px": 0
      },
      "content": {
        "mod": "new-task"
      }
    },
    {
      "id": "branch-cleanup-cache",
      "type": "block",
      "size": {
        "px": 0
      },
      "content": {
        "mod": "branch-cleanup",
        "props": {
          "auto": true
        }
      }
    }
  ]
}
